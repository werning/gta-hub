# Kopiere diese Datei zu .env.local und trage echte Werte ein.
# .env.local wird NICHT eingecheckt (siehe .gitignore).

# Öffentliche Basis-URL der Seite (für Sitemap, robots.txt, SEO-Metadaten).
# Lokal nicht nötig (Standard: http://localhost:3000). Auf Vercel als
# https://deine-domain.de setzen.
# NEXT_PUBLIC_SITE_URL=https://deine-domain.de

# Pflicht für den täglichen News-Workflow.
# Eigenen Key erstellen: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: anderes Modell verwenden (Standard: claude-haiku-5-5)
# ANTHROPIC_MODEL=claude-haiku-5-5

# Pflicht für den Freigabe-Bereich unter /admin/news.
# Frei wählbares Passwort, mindestens 12 Zeichen.
ADMIN_PASSWORD=

# Nur für den ONLINE-Betrieb nötig (Vercel), nicht für die lokale
# Entwicklung: Ohne diese drei Werte schreibt die Seite Artikel lokal auf
# die Festplatte; mit diesen Werten committet sie sie stattdessen direkt
# ins GitHub-Repo (nötig, weil Vercel zur Laufzeit nicht dauerhaft
# schreibbar ist). Siehe CLAUDE.md, Abschnitt "Online stellen".
# GITHUB_TOKEN=          Fine-grained Personal Access Token, nur "Contents: Read & write" auf dieses eine Repo
# GITHUB_REPO=           z. B. dein-github-name/leonida-living
# GITHUB_BRANCH=main

# Nur für den ONLINE-Betrieb: schützt die tägliche Cron-Route vor fremdem
# Zugriff. Vercel setzt den passenden Header automatisch, wenn diese
# Variable in den Vercel-Projekteinstellungen gesetzt ist.
# CRON_SECRET=

# Optional: Bestätigungscodes für Google Search Console / Bing Webmaster
# Tools (Variante "HTML-Tag"/"Meta-Tag"). Nur den Code-Teil eintragen,
# nicht das ganze <meta>-Tag. Siehe CLAUDE.md, Abschnitt "Suchmaschinen".
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
